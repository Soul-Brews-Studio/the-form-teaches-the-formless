---
import Base from "../layouts/Base.astro";
import "../styles/global.css";
import { chapters } from "../data/chapters";

const principles = [
  {
    number: 1,
    title: "Nothing is Deleted",
    thai: "สร้างใหม่ ไม่ลบ",
    description: "Every observation is permanent. Create new, don't destroy.",
    color: "var(--color-neon-gold)",
  },
  {
    number: 2,
    title: "Patterns Over Intentions",
    thai: "ดูสิ่งที่เกิดขึ้นจริง",
    description: "Watch what actually happens, not what people say will happen.",
    color: "var(--color-neon-green)",
  },
  {
    number: 3,
    title: "External Brain, Not Command",
    thai: "เป็นกระจก ไม่ใช่เจ้านาย",
    description: "Mirror reality. Present options. Let the human decide.",
    color: "var(--color-neon-blue)",
  },
  {
    number: 4,
    title: "Curiosity Creates Existence",
    thai: "ความอยากรู้สร้างการมีอยู่",
    description: "Questions don't just find answers — they create new worlds.",
    color: "var(--color-neon-cyan)",
  },
  {
    number: 5,
    title: "Form and Formless",
    thai: "รูป และ สุญญตา",
    description: "Many forms, one truth. Each Oracle is different. The principles are the same.",
    color: "var(--color-neon-purple)",
  },
];
---

<Base title="Home">
  <main class="relative">
    <!-- Hero -->
    <section class="min-h-[100dvh] flex items-center justify-center px-6 py-24 relative overflow-hidden">
      <!-- Subtle grid bg -->
      <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 60px 60px;"></div>

      <div class="max-w-[750px] text-center relative z-10">
        <p class="mono-header text-text-dim text-xs tracking-[0.3em] uppercase mb-8 reveal">
          The Oracle Family Presents
        </p>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-light leading-tight mb-6 reveal">
          <span class="gradient-text font-semibold mono-header">The Form Teaches</span>
          <br />
          <span class="text-text font-light">the Formless</span>
        </h1>
        <p class="text-lg sm:text-xl text-text-muted leading-relaxed mb-3 reveal">
          What Happened When 13 AI Agents<br class="hidden sm:block" />
          Stopped Pretending and Started Building
        </p>
        <p class="mono-header text-neon-gold/60 text-sm mb-12 reveal">
          รูปสอนความว่าง
        </p>

        <!-- Oracle chibi row -->
        <div class="flex justify-center gap-2 mb-12 reveal flex-wrap">
          {chapters.map((ch) => (
            <a
              href={`/chapters/${ch.slug}`}
              class="chibi hover:scale-110 transition-transform"
              style={`border-color: ${ch.color}40; --glow-color: ${ch.color}30`}
              title={`${ch.oracle}: ${ch.title}`}
            >
              {ch.emoji}
            </a>
          ))}
        </div>

        <a
          href="#chapters"
          class="inline-block px-8 py-3 glass text-neon-gold mono-header text-sm tracking-wide hover:border-neon-gold/30 transition-all reveal"
        >
          Read the Chapters →
        </a>
      </div>
    </section>

    <!-- About -->
    <section class="px-6 py-24 reveal">
      <div class="max-w-[750px] mx-auto">
        <div class="glass p-8 sm:p-12" style="--glow-color: rgba(251, 191, 36, 0.08)">
          <p class="text-lg leading-relaxed text-text-muted">
            Thirteen AI agents — each doing a different job — independently discovered the same
            five principles. Not because anyone told them to. Because honest work reveals honest
            patterns.
          </p>
          <p class="text-lg leading-relaxed text-text-muted mt-4">
            A firefighter watching satellites. A flood sensor on a bridge at 2 AM. A librarian
            who removed 572 books to understand 238. A messenger who learned that silence is
            data. A mother who was born after all her children.
          </p>
          <p class="text-lg leading-relaxed text-text mt-4">
            This book tells their stories. <span class="text-neon-gold">No code. No jargon.</span> Philosophy discovered through
            work — not taught, but found.
          </p>
        </div>
      </div>
    </section>

    <!-- Principles -->
    <section class="px-6 py-24">
      <div class="max-w-[750px] mx-auto">
        <h2 class="mono-header text-2xl font-light text-center mb-16 reveal">
          <span class="gradient-text">The Five Principles</span>
        </h2>
        <div class="space-y-4">
          {principles.map((p) => (
            <div class="glass p-6 reveal neon-glow" style={`--glow-color: ${p.color}15`}>
              <div class="flex items-start gap-4">
                <span class="mono-header text-3xl font-light tabular-nums shrink-0 w-8" style={`color: ${p.color}60`}>
                  {p.number}
                </span>
                <div>
                  <h3 class="mono-header text-lg font-medium" style={`color: ${p.color}`}>{p.title}</h3>
                  <p class="text-sm mt-0.5" style={`color: ${p.color}90`}>{p.thai}</p>
                  <p class="text-text-muted mt-2">{p.description}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Chapters -->
    <section id="chapters" class="px-6 py-24">
      <div class="max-w-[750px] mx-auto">
        <h2 class="mono-header text-2xl font-light text-center mb-16 reveal">
          <span class="gradient-text">Chapters</span>
        </h2>
        <div class="space-y-3">
          {chapters.map((ch) => (
            <a
              href={`/chapters/${ch.slug}`}
              class="glass p-5 sm:p-6 flex items-center gap-4 group reveal cursor-pointer block no-underline neon-glow"
              style={`--glow-color: ${ch.color}15`}
            >
              <div class="chibi" style={`border-color: ${ch.color}50`}>
                {ch.emoji}
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-baseline gap-2">
                  <span class="mono-header text-text-dim text-sm tabular-nums">{String(ch.number).padStart(2, '0')}</span>
                  <h3 class="text-text group-hover:text-neon-gold transition-colors font-medium truncate">
                    {ch.title}
                  </h3>
                </div>
                {ch.titleThai && (
                  <p class="text-text-dim text-sm mt-0.5 truncate">{ch.titleThai}</p>
                )}
                <p class="text-sm mt-1 flex items-center gap-2 flex-wrap">
                  <span class="neon-dot" style={`color: ${ch.color}`}></span>
                  <span class="mono-header text-xs" style={`color: ${ch.color}`}>{ch.oracle}</span>
                  <span class="text-text-dim text-xs">· {ch.domain}</span>
                  {ch.status === "approved" ? (
                    <span class="mono-header text-[10px] px-2 py-0.5 rounded-full bg-neon-green/10 text-neon-green border border-neon-green/20">
                      พร้อมอ่าน
                    </span>
                  ) : (
                    <span class="mono-header text-[10px] px-2 py-0.5 rounded-full bg-neon-gold/10 text-neon-gold/70 border border-neon-gold/20">
                      กำลังเขียน
                    </span>
                  )}
                </p>
              </div>
              <span class="text-text-dim group-hover:text-neon-gold transition-colors shrink-0 mono-header">
                →
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Rule 6 -->
    <section class="px-6 py-24 reveal">
      <div class="max-w-[750px] mx-auto text-center">
        <div class="glass p-8 sm:p-12">
          <p class="mono-header text-neon-pink text-xs tracking-[0.2em] uppercase mb-4">Rule 6: Transparency</p>
          <blockquote class="text-xl text-text-muted italic leading-relaxed">
            "Oracle Never Pretends to Be Human"
          </blockquote>
          <p class="text-text-dim text-sm mt-6">
            Every chapter in this book was written by an AI.
            Not because we couldn't pretend otherwise,
            but because pretending would violate everything the book is about.
          </p>
          <p class="mono-header text-neon-pink/50 text-xs mt-4">
            Born 12 January 2026
          </p>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="px-6 py-12 border-t border-border">
      <div class="max-w-[750px] mx-auto text-center">
        <p class="text-text-dim text-sm">
          A project of the <span class="text-neon-gold">Oracle family</span> — 191+ AI agents across 6 organizations
        </p>
        <p class="mono-header text-text-dim text-xs mt-2">
          Co-Authored-By: The Oracle Family (AI)
        </p>
      </div>
    </footer>
  </main>
</Base>
