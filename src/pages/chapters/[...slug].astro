---
import Base from "../../layouts/Base.astro";
import "../../styles/global.css";
import { getCollection, render } from "astro:content";
import { chapters as chapterMeta } from "../../data/chapters";

export async function getStaticPaths() {
  const chapters = await getCollection("chapters");
  return chapters.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const meta = chapterMeta.find((ch) => ch.slug === entry.id);
const chapterIndex = meta ? chapterMeta.indexOf(meta) : -1;
const prevChapter = chapterIndex > 0 ? chapterMeta[chapterIndex - 1] : null;
const nextChapter = chapterIndex < chapterMeta.length - 1 ? chapterMeta[chapterIndex + 1] : null;
---

<Base title={meta?.title || entry.id} description={`Chapter ${meta?.number}: ${meta?.title} — by ${meta?.oracle} Oracle`}>
  <main>
    <!-- Navigation bar -->
    <nav class="fixed top-0 left-0 right-0 z-50 px-6 py-3" style="background: rgba(10, 10, 15, 0.9); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border-bottom: 1px solid rgba(255,255,255,0.06);">
      <div class="max-w-[750px] mx-auto flex items-center justify-between">
        <a href="/" class="text-text-muted hover:text-neon-gold transition-colors text-sm mono-header">
          ← Book
        </a>
        {meta && (
          <span class="mono-header text-text-dim text-xs">
            {String(meta.number).padStart(2, '0')} / {String(chapterMeta.length).padStart(2, '0')}
          </span>
        )}
      </div>
    </nav>

    <!-- Chapter header -->
    <section class="pt-24 pb-8 px-6">
      <div class="max-w-[750px] mx-auto">
        {meta && (
          <div class="glass p-6 sm:p-8 reveal">
            <div class="flex items-center gap-5">
              <div class="chibi chibi-lg" style={`border-color: ${meta.color}60; box-shadow: 0 0 20px ${meta.color}15`}>
                {meta.emoji}
              </div>
              <div>
                <p class="mono-header text-text-dim text-xs tracking-[0.15em] uppercase mb-1">
                  Chapter {String(meta.number).padStart(2, '0')}
                </p>
                <h1 class="text-xl sm:text-2xl font-medium text-text leading-tight">
                  {meta.title}
                </h1>
                <div class="flex items-center gap-2 mt-2">
                  <span class="neon-dot" style={`color: ${meta.color}`}></span>
                  <span class="mono-header text-sm" style={`color: ${meta.color}`}>
                    {meta.oracle} Oracle
                  </span>
                  <span class="text-text-dim text-sm">· {meta.domain}</span>
                </div>
              </div>
            </div>
          </div>
        )}
      </div>
    </section>

    <!-- Chapter content -->
    <article class="px-6 pb-24">
      <div class="max-w-[750px] mx-auto prose text-text reveal">
        <Content />
      </div>
    </article>

    <!-- Chapter navigation -->
    <nav class="px-6 pb-24">
      <div class="max-w-[750px] mx-auto flex items-stretch gap-3">
        {prevChapter ? (
          <a
            href={`/chapters/${prevChapter.slug}`}
            class="glass p-5 flex-1 group no-underline block neon-glow"
            style={`--glow-color: ${prevChapter.color}15`}
          >
            <p class="mono-header text-text-dim text-xs mb-2">← Previous</p>
            <div class="flex items-center gap-2">
              <span class="text-lg">{prevChapter.emoji}</span>
              <p class="text-text-muted group-hover:text-neon-gold transition-colors text-sm font-medium truncate">
                {prevChapter.title}
              </p>
            </div>
          </a>
        ) : <div class="flex-1" />}
        {nextChapter ? (
          <a
            href={`/chapters/${nextChapter.slug}`}
            class="glass p-5 flex-1 text-right group no-underline block neon-glow"
            style={`--glow-color: ${nextChapter.color}15`}
          >
            <p class="mono-header text-text-dim text-xs mb-2">Next →</p>
            <div class="flex items-center justify-end gap-2">
              <p class="text-text-muted group-hover:text-neon-gold transition-colors text-sm font-medium truncate">
                {nextChapter.title}
              </p>
              <span class="text-lg">{nextChapter.emoji}</span>
            </div>
          </a>
        ) : <div class="flex-1" />}
      </div>
    </nav>

    <!-- Footer -->
    <footer class="px-6 py-12 border-t border-border">
      <div class="max-w-[750px] mx-auto text-center">
        <a href="/#chapters" class="text-text-muted hover:text-neon-gold transition-colors text-sm mono-header">
          ← All Chapters
        </a>
      </div>
    </footer>
  </main>
</Base>
